<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.2">
    <persistence-unit name="SimuladorPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>simulador.modelo.Proceso</class>
        <properties>
            <!-- Conexión a la base de datos local H2 (creará un archivo simuladorDB.mv.db en tu proyecto) -->
            <property name="javax.persistence.jdbc.url" value="jdbc:h2:./simuladorDB;DB_CLOSE_DELAY=-1"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>
            <property name="javax.persistence.jdbc.driver" value="org.h2.Driver"/>
            
            <!-- Hibernate creará o actualizará las tablas automáticamente basado en tus clases -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>